# Copy to .env and fill in. NEVER commit .env.
# Local: cp .env.example .env

APP_NAME="LedgerHive"
APP_ENV=local              # local | staging | production
APP_DEBUG=true             # MUST be false in production
APP_URL=http://localhost/SupportHive/public
APP_KEY=                   # 32+ random bytes, base64. Generate: php scripts/genkey.php
APP_TIMEZONE=UTC
# Only needed when the document root is NOT <project>/public - i.e. the
# deployed layout, where the application sits outside the web root. CLI tools
# cannot infer it. The deploy workflow writes this automatically.
APP_PUBLIC_PATH=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=supporthive
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4
# PHPUnit uses this schema instead, so tests and development data stay apart.
# Defaults to DB_NAME with _test appended.
DB_NAME_TEST=supporthive_test

# Session / cookies
SESSION_NAME=shsid
SESSION_LIFETIME=7200      # seconds
SESSION_SECURE=false       # true in production (HTTPS only)
SESSION_SAMESITE=Lax

# Security
# Password-free login buttons on the sign-in page. Testing only.
# Leave false anywhere real people can reach the site.
DEV_QUICK_LOGIN=false

CSRF_TOKEN_LIFETIME=7200
PASSWORD_MIN_LENGTH=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900

# Mail (SMTP) - used for expense notifications (Settings > Email notifications).
# Leave MAIL_HOST blank to turn mail off: the app logs what it would have sent.
# Use your provider's SMTP submission host and an app password / SMTP key,
# never the account's main password. The certificate is always verified.
MAIL_HOST=
MAIL_PORT=587              # 587 = STARTTLS, 465 = implicit TLS
MAIL_USER=
MAIL_PASS=
# tls | starttls | none. Defaults from MAIL_PORT (465 -> tls, else starttls).
# "none" is only for a local mail catcher; credentials are refused on it.
MAIL_ENCRYPTION=
MAIL_TIMEOUT=10            # seconds per connect/reply; sending happens in the request
MAIL_FROM=no-reply@example.com   # must be an address your provider lets you send as
MAIL_FROM_NAME="LedgerHive"

# Uploads
UPLOAD_MAX_BYTES=5242880
# Employee documents (PDF only). Keep php.ini upload_max_filesize/post_max_size above this.
UPLOAD_PDF_MAX_BYTES=10485760
UPLOAD_ALLOWED_MIME=image/jpeg,image/png,image/webp,application/pdf
