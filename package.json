{
  "name": "supporthive",
  "private": true,
  "version": "0.1.0",
  "description": "Front-end build for SupportHive (Tailwind CSS + vendored JS libraries)",
  "scripts": {
    "dev": "tailwindcss -i public/assets/css/app.src.css -o public/assets/css/app.css --watch",
    "build": "tailwindcss -i public/assets/css/app.src.css -o public/assets/css/app.css --minify",
    "vendor": "node scripts/vendor-assets.mjs"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "tailwindcss": "^4.0.0"
  },
  "dependencies": {
    "alpinejs": "^3.14.0",
    "apexcharts": "^3.54.0",
    "lucide": "^0.460.0"
  }
}
