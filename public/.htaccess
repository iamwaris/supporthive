# ---------------------------------------------------------------------------
# Front controller + web-server hardening. This is the document root.
# ---------------------------------------------------------------------------

Options -Indexes -MultiViews
DirectoryIndex index.php

# Re-grant access explicitly.
#
# The repository root ships a deny-all .htaccess as a safety net, and Apache
# applies every parent directory's .htaccess to this one. Serving the project
# from a subfolder (http://localhost/LedgerHive/public/) therefore inherits
# that denial and returns 403 on every request. This directory IS the public
# one, so it says so rather than depending on where it sits.
<IfModule mod_authz_core.c>
    Require all granted
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Allow from all
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Force HTTPS in production. Safe to leave on: localhost is excluded.
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP_HOST} !^localhost [NC]
    RewriteCond %{HTTP_HOST} !^127\.0\.0\.1 [NC]
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Strip a trailing slash (except the root) so URLs are canonical.
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.+)/$ /$1 [L,R=301]

    # Serve real files and directories as-is; everything else goes to index.php.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
</IfModule>

# Block dotfiles, backups, VCS leftovers and config dropped here by accident.
<FilesMatch "(^\.|\.(env|ini|log|sh|sql|bak|old|swp|dist|json|lock|md|yml|yaml)$|composer|package)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Defence in depth: the app sends these too, but static files bypass PHP.
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always unset X-Powered-By
    Header always unset Server

    # Content-Security-Policy is set HERE, not only in PHP.
    #
    # Hostinger's server configuration sets its own CSP
    # ("upgrade-insecure-requests") and it overrides the one PHP sends with
    # header(), so on that host the application's policy never reached the
    # browser at all - verified against the origin, so it is the server and
    # not the CDN. mod_headers runs after PHP, so unsetting and re-setting
    # here wins.
    #
    # Keep this string in sync with Http::sendSecurityHeaders(). The PHP copy
    # still matters: it covers the built-in dev server and any host where
    # .htaccess is ignored. See docs/SECURITY.md section 3 for why
    # 'unsafe-eval' (Alpine) and 'unsafe-inline' for styles (ApexCharts) are
    # present, and never add 'unsafe-inline' to script-src.
    # Two unsets on purpose: `always` clears the error-response table, plain
    # clears the normal one where PHP's own header() lands. Without both, the
    # response carries TWO CSP headers and the browser enforces their
    # intersection - identical today, silently broken the day they drift.
    Header always unset Content-Security-Policy
    Header unset Content-Security-Policy
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"
</IfModule>

<IfModule mod_php.c>
    php_flag display_errors Off
    php_flag expose_php Off
    php_flag allow_url_fopen Off
    php_flag allow_url_include Off
</IfModule>

# Long-cache fingerprinted assets, never cache HTML.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

ErrorDocument 403 /index.php
ErrorDocument 404 /index.php
