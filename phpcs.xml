<?xml version="1.0"?>
<ruleset name="SupportHive">
    <description>PSR-12 with project additions.</description>

    <file>app</file>
    <file>public</file>
    <file>config</file>
    <file>routes</file>
    <file>database</file>
    <file>tests</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/storage/*</exclude-pattern>

    <arg name="colors"/>
    <arg name="extensions" value="php"/>
    <arg value="sp"/>

    <rule ref="PSR12"/>

    <!-- Hard bans: these are how SQL injection and XSS get in. -->
    <rule ref="Generic.PHP.ForbiddenFunctions">
        <properties>
            <property name="forbiddenFunctions" type="array">
                <element key="eval" value="null"/>
                <element key="exec" value="null"/>
                <element key="shell_exec" value="null"/>
                <element key="system" value="null"/>
                <element key="passthru" value="null"/>
                <element key="popen" value="null"/>
                <element key="extract" value="null"/>
                <element key="md5" value="null"/>
                <element key="sha1" value="null"/>
                <element key="mysql_query" value="null"/>
                <element key="mysqli_query" value="null"/>
                <element key="create_function" value="null"/>
                <element key="unserialize" value="json_decode"/>
                <element key="var_dump" value="null"/>
                <element key="print_r" value="null"/>
                <element key="dd" value="null"/>
            </property>
        </properties>
    </rule>

    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="120"/>
            <property name="absoluteLineLimit" value="160"/>
        </properties>
    </rule>
</ruleset>
